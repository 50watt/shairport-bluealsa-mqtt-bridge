[Unit]
Description=Shairport BlueALSA bridge web dashboard
Documentation=https://github.com/50watt/shairport-bluealsa-mqtt-bridge
Wants=network-online.target bridge-status-export.service
After=network-online.target bridge-status-export.service

[Service]
Type=simple
User=bridge-web
Group=bridge-web
WorkingDirectory=/opt/shairport-bluealsa-mqtt-bridge/web
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=BRIDGE_STATUS_FILE=/run/shairport-bluealsa-mqtt-bridge/status.json
Environment=BRIDGE_WEB_CONFIG=/etc/shairport-bluealsa-mqtt-bridge/web.json
Environment=BRIDGE_PASSWORD_FILE=/var/lib/shairport-bluealsa-mqtt-bridge/password.json
StateDirectory=shairport-bluealsa-mqtt-bridge
StateDirectoryMode=0750
ExecStart=/usr/bin/gunicorn --workers 1 --threads 2 --bind 0.0.0.0:8080 --access-logfile - --error-logfile - "bridge_web:create_app()"
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/shairport-bluealsa-mqtt-bridge
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
