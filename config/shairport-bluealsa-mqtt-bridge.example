# MQTT broker and topic namespace.
MQTT_HOST="192.0.2.10"
MQTT_PORT="1883"
MQTT_TOPIC_PREFIX="audio/bridge/bluetooth"
MQTT_CONFIG_DIRECTORY="/etc/shairport-bluealsa-mqtt"
MQTT_STATUS_CLIENT_ID="bluealsa_mqtt_status"
MQTT_CONTROL_CLIENT_ID="bluealsa_mqtt_control"

# Bluetooth speaker identity.
BLUETOOTH_ADAPTER="hci0"
SPEAKER_MAC=""
SPEAKER_NAME="Bluetooth speaker"

# Polling and heartbeat intervals in seconds.
POLL_INTERVAL="5"
DETAIL_INTERVAL="30"
HEARTBEAT_INTERVAL="60"

# Audio controls.
VOLUME_STEP="5"
VOLUME_MAX="100"

# Recovery behavior.
RECONNECT_TIMEOUT="20"
RECOVERY_COOLDOWN="60"

# hcitool is deprecated but still provides controller-specific RSSI and link
# quality values for an active Bluetooth Classic connection. Set this to false
# if hcitool is unavailable or if these metrics are not required.
ENABLE_HCI_METRICS="true"

# Service names can be overridden for distributions with different units.
BLUETOOTH_SERVICE="bluetooth.service"
BLUEALSA_SERVICE="bluealsa.service"
SHAIRPORT_SERVICE="shairport-sync.service"
