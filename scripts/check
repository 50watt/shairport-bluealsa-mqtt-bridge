#!/usr/bin/env bash

# Run lightweight repository checks without modifying the system.

set -euo pipefail

PROJECT_DIRECTORY="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly PROJECT_DIRECTORY

mapfile -t shell_files < <(
    find "${PROJECT_DIRECTORY}" \
        -type f \
        \( -name '*.sh' -o -path '*/scripts/*' \) \
        -print |
    sort
)

for shell_file in "${shell_files[@]}"; do
    bash -n "${shell_file}"
done

"${PROJECT_DIRECTORY}/tests/common-tests.sh"
"${PROJECT_DIRECTORY}/tests/interface-tests.sh"

python3 - "${PROJECT_DIRECTORY}/web" <<'PYTHON'
import ast
import pathlib
import sys

for python_file in pathlib.Path(sys.argv[1]).rglob("*.py"):
    ast.parse(python_file.read_text(encoding="utf-8"), filename=str(python_file))
PYTHON

if python3 -c 'import flask, werkzeug' >/dev/null 2>&1; then
    python3 "${PROJECT_DIRECTORY}/tests/web-tests.py"
else
    printf 'Web authentication tests skipped: Flask is not installed.\n'
fi

required_units=(
    bluealsa-mqtt-control.service
    bluealsa-mqtt-status.service
    bluetooth-reconnect.service
    bluetooth-reconnect.timer
    bridge-status-export.service
    bridge-web.service
)

for required_unit in "${required_units[@]}"; do
    if [[ ! -s "${PROJECT_DIRECTORY}/systemd/${required_unit}" ]]; then
        printf 'Missing or empty systemd unit: %s\n' "${required_unit}" >&2
        exit 1
    fi
done

if command -v shellcheck >/dev/null 2>&1; then
    shellcheck -x -P SCRIPTDIR "${shell_files[@]}"
fi

printf 'All checks passed.\n'
